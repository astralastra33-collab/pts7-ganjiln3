# =========================================================================
# ENVIRONMENT VARIABLES VERCEL — SICIBINAGA KELAS 7
# Salin variabel di bawah ke: Vercel Project -> Settings -> Environment Variables
# =========================================================================

# 1. [WAJIB] Kunci JSON Google Service Account (boleh JSON utuh 1 baris atau Base64)
#    PENTING: Share Google Spreadsheet (1YZ-TlyZ4FAuhtaYHQyuaLi3rDrwjJWopIdJ9--jWdII) sebagai EDITOR ke client_email Service Account!
GOOGLE_SERVICE_ACCOUNT_JSON=

# 2. [WAJIB] Kunci service_role rahasia dari Supabase Kelas 7 (https://xraqhfkrwwvlkvoulzuv.supabase.co)
SUPABASE_SERVICE_ROLE_KEY=

# 3. [DISARANKAN] Rahasia acak 32+ karakter untuk tanda tangan token sesi Admin & 2FA OTP
SESSION_SECRET=ganti_dengan_string_acak_minimal_32_karakter_kelas7

# 4. [OPSIONAL] Kunci API Resend (gratis di resend.com) agar 2FA OTP Email Admin berjalan di Vercel
RESEND_API_KEY=
EMAIL_FROM=SICIBINAGA Kelas 7 <onboarding@resend.dev>

# 5. [OPSIONAL] Folder ID Google Drive induk (jika ingin upload gambar & arsip bank soal masuk ke folder Drive pribadi Anda)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# 6. [SUDAH TERTANAM BAWAAN] 5 API Key Groq Kelas 7 sudah tertanam di backend-core.js
#    dan tetap bisa di-override kapan saja lewat Environment Variables Vercel di bawah ini:
# GROQ_CBT_API_KEY_K7=
# GROQ_LMS_API_KEY_K7=
# GROQ_STUDENT_TUTOR_API_KEY_K7=
# GROQ_VIDEO_API_KEY_K7=
# GROQ_BANKSOAL_QUIZ_API_KEY_K7=
