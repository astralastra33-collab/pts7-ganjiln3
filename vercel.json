{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/rpc.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/health.js": {
      "maxDuration": 15,
      "memory": 256
    }
  },
  "headers": [
    {
      "source": "/(style\\.css|app\\.js|vercel-bridge\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=600" }
      ]
    }
  ]
}
